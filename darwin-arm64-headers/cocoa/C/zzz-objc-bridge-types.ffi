(struct ("" 0)
 "NSSimpleCString"
 (("isa" (field (pointer (void ())) 0 8))
  ("bytes" (field (pointer (signed-char ())) 8 8))
  ("numBytes" (field (unsigned-long ()) 16 8))))
(struct ("" 0)
 "NSConstantString"
 (("isa" (field (pointer (void ())) 0 8))
  ("bytes" (field (pointer (signed-char ())) 8 8))
  ("numBytes" (field (unsigned-long ()) 16 8))))
